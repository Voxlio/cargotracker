# Copy this file to ".env" and fill in real values. NEVER commit ".env" to Git.

# Staff login
ADMIN_USER=
ADMIN_PASS=

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# Optional: websites allowed to call the API from a browser (comma separated)
# ALLOWED_ORIGINS=

# Optional: timezone for server-generated dates (default UTC)
# APP_TIMEZONE=America/New_York

# Optional for local testing against Redis (leave empty to use database.json)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
